# Copy to .env.local:
#   cp .env.local.example .env.local
#
# DATA_PROVIDER=supabase  → current cloud/self-hosted Supabase (default)
# DATA_PROVIDER=postgres  → standalone PostgreSQL on your VPS / Docker

DATA_PROVIDER=supabase
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase mode (default, production today) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Postgres mode (prepare in parallel, switch later) ---
# DATA_PROVIDER=postgres
# DATABASE_URL=postgresql://tasksite:tasksite@localhost:5432/tasksite
# AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
#
# Local Postgres:
#   npm run db:up
#   npm run create-teacher -- teacher@example.com 'your-password'
#
# See deploy/vps/README.md
